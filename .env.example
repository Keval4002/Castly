# ---------- Core ----------
APP_URL=https://castly.example.com
# Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# openssl rand -base64 48
SESSION_SECRET=

# ---------- Auth + Storage (Supabase) ----------
AUTH_PROVIDER=supabase            # "dev" = local email-only login (never in production)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=supabase           # "local" = .data/storage (dev only)
SUPABASE_STORAGE_BUCKET=castly    # create as a PRIVATE bucket

# ---------- Prompt LLM (Vercel AI SDK) ----------
# Preferred LLM; every other configured one is tried next, then a template.
PROMPT_LLM=gemini                 # gemini | groq | claude | template
GEMINI_API_KEY=                   # free tier available — aistudio.google.com
GEMINI_PROMPT_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=                     # FREE tier, no card — console.groq.com
GROQ_PROMPT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ANTHROPIC_API_KEY=
CLAUDE_PROMPT_MODEL=claude-haiku-5-5

# Product-photo classifier: detects category + product type at upload and corrects
# mismatched user input. Uses the same LLMs as above (vision). auto | mock | off
CLASSIFIER_MODE=auto

# ---------- Image providers ----------
# live = paid production chains · free = free-tier models only (testing) · mock = offline
IMAGE_PROVIDER_MODE=live
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
FAL_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# FREE: Cloudflare Workers AI (10k neurons/day). Token needs "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=false

# Only for local production builds / e2e with dev auth + mocks
ALLOW_INSECURE_DEV_MODE=false
