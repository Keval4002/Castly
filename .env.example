# ---------- Core ----------
APP_URL=https://dukaanshot.example.com
# Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# openssl rand -base64 48
SESSION_SECRET=

# ---------- Auth + Storage (Supabase) ----------
AUTH_PROVIDER=supabase            # "dev" = local email-only login (never in production)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=supabase           # "local" = .data/storage (dev only)
SUPABASE_STORAGE_BUCKET=dukaanshot    # create as a PRIVATE bucket

# ---------- Prompt LLM (Vercel AI SDK) ----------
# Preferred LLM; every other configured one is tried next, then a template.
PROMPT_LLM=gemini                 # gemini | groq | claude | template
GEMINI_API_KEY=                   # free tier available — aistudio.google.com
GEMINI_PROMPT_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash  # stricter product-fidelity judge; falls back to the prompt LLMs
GROQ_API_KEY=                     # FREE tier, no card — console.groq.com
GROQ_PROMPT_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
CLAUDE_PROMPT_MODEL=claude-haiku-5-5

# Product-photo classifier: detects category + product type at upload and corrects
# mismatched user input. Uses the same LLMs as above (vision). auto | mock | off
CLASSIFIER_MODE=auto

# Photo cleaning after upload (BiRefNet background removal, MIT licence).
# auto = fal if FAL_KEY, else local model (dev/self-host, not Vercel), else basic trim/pad
BACKGROUND_REMOVAL=auto           # auto | fal | local | off
# Every generated image is compared to the product by a vision LLM.
# enforce = regenerate if the product changed, refund if it still differs
# Fails closed: if no judge can be reached the image is HELD (never delivered or charged)
# and re-checked, then refunded after 30 min. With no judge keys (local dev) use flag or off.
FIDELITY_MODE=enforce             # enforce | flag | off
FIDELITY_THRESHOLD=0.8
GENERATION_MAX_ATTEMPTS=2

# ---------- Image providers ----------
# live = paid production chains · free = free-tier models only (testing) · mock = offline
IMAGE_PROVIDER_MODE=live
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
FAL_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# FREE: Cloudflare Workers AI (10k neurons/day). Token needs "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=false

# Only for local production builds / e2e with dev auth + mocks
ALLOW_INSECURE_DEV_MODE=false

# ---------- Emergency stop ----------
# true = pause ALL paid image generation (needs a restart). For an instant switch without a
# deploy run:  npm run kill-switch -- on "Back soon"   /   npm run kill-switch -- off
GENERATION_PAUSED=false
